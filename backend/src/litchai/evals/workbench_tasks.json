     "oracle": {"tool": "query_sql", "args": {"sql": "SELECT sum(debit) FROM bank WHERE description ILIKE '%charge%'"}},
     "checks": [{"any_number": 5000}], "answer": [5000]},
    {"id": "sql-ledger-rows", "category": "read", "fixture": "ledger_bank",
     "prompt": "How many transactions are in the ledger?",
     "expect_tools": ["query_sql", "profile_workbook"],
     "oracle": {"tool": "query_sql", "args": {"sql": "SELECT count(*) FROM ledger"}},
     "checks": [{"any_number": 12}], "answer": [12]},
