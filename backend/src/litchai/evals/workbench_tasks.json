     "oracle": {"tool": "query_sql", "args": {"sql": "SELECT avg(credit) FROM ledger WHERE credit IS NOT NULL"}},
     "checks": [{"any_number": 2500000}], "answer": [2500000]},
    {"id": "sql-salaries", "category": "read", "fixture": "ledger_bank",
