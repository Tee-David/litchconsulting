{
  "version": "wb-eval-1",
  "notes": "Golden answers are hand-computed from litchai.evals.fixtures (see the module docstring) and the shared tax config (2026.1). prep steps run and are accepted before the model sees the task. Each task's oracle is the deterministic tool call that proves the golden; tests/test_workbench_evals.py runs every oracle offline.",
  "tasks": [
    {"id": "sql-total-income", "category": "read", "fixture": "ledger_bank",
     "prompt": "What is the total income recorded in the ledger this quarter?",
     "expect_tools": ["query_sql", "profile_workbook"],
     "oracle": {"tool": "query_sql", "args": {"sql": "SELECT sum(credit) FROM ledger"}},
     "checks": [{"any_number": 7500000}], "answer": [7500000]},
    {"id": "sql-total-expenses", "category": "read", "fixture": "ledger_bank",
     "prompt": "Total of all payments (debits) in the ledger?",
     "expect_tools": ["query_sql", "profile_workbook"],
     "oracle": {"tool": "query_sql", "args": {"sql": "SELECT sum(debit) FROM ledger"}},
     "checks": [{"any_number": 4945000}], "answer": [4945000]},
    {"id": "sql-bank-closing", "category": "read", "fixture": "ledger_bank",
     "prompt": "What is the closing balance on the bank statement?",
     "expect_tools": ["query_sql", "profile_workbook"],
     "oracle": {"tool": "query_sql", "args": {"sql": "SELECT balance FROM bank ORDER BY _row DESC LIMIT 1"}},
     "checks": [{"any_number": 4595000}], "answer": [4595000]},
    {"id": "sql-bank-opening", "category": "read", "fixture": "ledger_bank",
     "prompt": "What was the opening bank balance before the first transaction?",
     "expect_tools": ["query_sql"],
     "oracle": {"tool": "query_sql", "args": {"sql": "SELECT balance - coalesce(credit, 0) + coalesce(debit, 0) FROM bank WHERE _row = 2"}},
     "checks": [{"any_number": 1000000}], "answer": [1000000]},
    {"id": "sql-bank-charges", "category": "read", "fixture": "ledger_bank",
     "prompt": "How much did the bank charge us in fees?",
