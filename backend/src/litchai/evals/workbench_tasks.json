     "oracle": {"tool": "profile_workbook", "args": {"level": 3}},
     "checks": [{"path": "workbooks.0.sheets.0.table.rows", "equals": 12}, {"path": "workbooks.0.sheets.1.table.rows", "equals": 11}],
     "answer": [12, 11]},

