[Unit]
Description=LitchAI idle-reclaim heartbeat (defers litchai.heartbeat)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=litch
Group=litch
WorkingDirectory=/srv/projects/litchconsulting/app/backend
ExecStart=/usr/local/bin/litch-run /srv/projects/litchconsulting/venv/bin/python -c "from litchai.queue import heartbeat; heartbeat.defer()"
